# Copy to .env and fill in. Variables starting with VITE_ are baked into the frontend at build time.

# --- Branding ---------------------------------------------------------------
# Name shown in emails, page titles and payment descriptions.
SITE_NAME=Animal Race
VITE_SITE_NAME=Animal Race
VITE_SUPPORT_EMAIL=suporte@example.com

# --- Server -----------------------------------------------------------------
# production for deploys. npm run dev sets development automatically.
NODE_ENV=production
PORT=3000
# Public https origin of the site (no trailing slash). Used in email links and Mercado Pago return/webhook URLs.
PUBLIC_APP_URL=https://www.example.com
# true when the server runs behind a proxy that sets X-Forwarded-For / X-Forwarded-Proto (Render, Netlify proxy).
TRUST_PROXY=true
# Serve the built frontend (dist/) from the Node server. Set false when the frontend is hosted elsewhere (Netlify).
SERVE_STATIC=true
# STATIC_DIR=dist

# --- Storage ----------------------------------------------------------------
# PostgreSQL connection string. Required in production.
DATABASE_URL=postgres://user:password@host:5432/animal_race
# require = TLS with certificate check, no-verify = TLS without certificate check (some managed hosts), empty = no TLS.
DATABASE_SSL=require
# DATABASE_POOL=5
# Without DATABASE_URL the server stores everything in DATA_DIR/accounts.json (development only).
# DATA_DIR=server/data
# Set true to allow the JSON file store in production (single instance, persistent disk only).
# ALLOW_JSON_STORE=false

# --- Administrators ---------------------------------------------------------
# Comma-separated emails that get the administrator panel at /admin.
ADMIN_EMAILS=admin@example.com

# --- Payments ---------------------------------------------------------------
# mercadopago = real checkout (PIX, card, boleto). demo = test checkout that charges nothing (never use in production).
PAYMENT_GATEWAY=mercadopago
PAYMENT_CURRENCY=BRL
# Mercado Pago production access token (APP_USR-...) and the webhook secret from "Suas integrações > Webhooks".
# Webhook URL to register: ${PUBLIC_APP_URL}/api/credits/webhook
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Only for PAYMENT_GATEWAY=demo: HMAC secret for the X-Duck-Signature test webhook.
PAYMENT_WEBHOOK_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
# Without SMTP the verification and reset links are shown on screen (development only).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to "SITE_NAME <SMTP_USER>".
MAIL_FROM=
