# Comma-separated emails that receive the administrator dashboard.
ADMIN_EMAILS=hokyminato@gmail.com

# demo completes a test checkout and does not charge a card.
# mercadopago sends the buyer to Mercado Pago and adds credits only after an approved payment is confirmed.
# Webhook: POST /api/credits/webhook
PAYMENT_GATEWAY=demo
PAYMENT_WEBHOOK_SECRET=

# Required when PAYMENT_GATEWAY=mercadopago. Use the client's Mercado Pago access token and webhook secret.
# PUBLIC_APP_URL is the public https origin Mercado Pago uses for the return page and webhook.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_APP_URL=
PAYMENT_CURRENCY=BRL 

# Optional. Without these, development shows the verification and reset links on screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Duck Race <duckracegame@gmail.com>
